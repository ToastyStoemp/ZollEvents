# ZollEvents configuration (all OPTIONAL). Copy to .env (gitignored) only if you
# want to preset values or provision headlessly — otherwise leave it unset and
# use the first-run setup wizard at /admin, which stores the admin password, the
# ZollTool source, the public base URL and branding in data/config.json.
# Anything set here OVERRIDES the wizard's stored value.

# ── Web server ──────────────────────────────────────────────────────────────
PORT=4300
# Public origin this service is reachable at — used to build the embed script's
# fetch URL and the iCal/webcal links. Set this to your real host in production.
PUBLIC_BASE_URL=https://events.example.com
# Trust X-Forwarded-For (login rate limit) — enable only behind a reverse proxy.
# ZOLLEVENTS_TRUST_PROXY=1

# ── Source: ZollTool read API ───────────────────────────────────────────────
# Mint a read-only token in ZollTool → Settings → Admin & diagnostics → API access.
ZOLLTOOL_URL=https://sync.example.com
ZOLLTOOL_API_TOKEN=zt_...

# ── Branding / display ──────────────────────────────────────────────────────
ORG_NAME=Phuong Ninjin
ORG_TAGLINE=Where to find us
# Show a "Past events" section on the public page (1 = yes, 0 = no).
SHOW_PAST=1
PAST_LIMIT=12
# How long to cache events from ZollTool (ms).
EVENTS_TTL_MS=300000

# ── Admin (edit per-event booth / link / blurb) ─────────────────────────────
# Leave blank to disable the /admin editor entirely.
ADMIN_PASSWORD=
# Signs the admin session cookie (defaults to ADMIN_PASSWORD).
# SESSION_SECRET=
